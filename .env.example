# InkoCaller Environment Variables
# Copy to .env and fill values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Session Security
SESSION_SECRET=change-this-to-32+chars-random-string-min
ENCRYPTION_KEY=change-this-to-32-chars-base64-key

# Database (optional - uses in-memory if not set)
DATABASE_URL=postgresql://user:password@localhost:5432/inkocaller
# Supabase alternative
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional - for scaling)
REDIS_URL=redis://localhost:6379

# TURN / coturn
# Generate temporary credentials using TURN_SECRET (static-auth-secret in coturn)
TURN_SECRET=inkocaller-dev-secret-change-in-prod
TURN_SERVER=turn:your-turn-server.com:3478
# For explicit credentials (fallback)
NEXT_PUBLIC_TURN_URL=turn:your-turn-server.com:3478
NEXT_PUBLIC_TURN_USERNAME=inkocaller
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential
NEXT_PUBLIC_TURN_SECRET=inkocaller-dev-secret-change-in-prod

# Monitoring
NEXT_PUBLIC_ENABLE_STATS=true

# Optional: OpenRelay fallback (free tier limited, not for production)
# NEXT_PUBLIC_TURN_URL=turn:openrelay.metered.ca:80
# NEXT_PUBLIC_TURN_USERNAME=openrelayproject
# NEXT_PUBLIC_TURN_CREDENTIAL=openrelayproject

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
