# InkoCaller Environment Variables
# Copy to .env and fill values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Session Security
SESSION_SECRET=change-this-to-32+chars-random-string-min
ENCRYPTION_KEY=change-this-to-32-chars-base64-key

# Database (optional - uses in-memory if not set)
DATABASE_URL=postgresql://user:password@localhost:5432/inkocaller
# Supabase alternative
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional - for scaling)
REDIS_URL=redis://localhost:6379

# TURN / coturn
# Required for cross-network media on your own TURN deployment.
# Generate a unique random secret (at least 32 characters); never use a committed default.
TURN_SECRET=
# Public TURN URI (not a secret). Example: turns:turn.example.com:443
TURN_SERVER=

# Monitoring
NEXT_PUBLIC_ENABLE_STATS=true

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
